# Supabase server-side credentials. Never expose these to browser/Cloudflare client code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_SECRET

# Shared secret used only between the authenticated CAMPUS360 Supabase Edge Function and this service.
AI_GATEWAY_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Local development: Ollama. Cloud deployment: set LLM_PROVIDER=openai and configure API values.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

CHUNK_SIZE=900
CHUNK_OVERLAP=140
TOP_K=5
